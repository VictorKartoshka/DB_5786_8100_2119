# =========================================================================
#  SAVED QUERIES
# =========================================================================

@app.route('/api/query/run', methods=['POST'])
def api_query_run():
    query_id = request.json.get('query_id')
    queries = {
        's1': '''SELECT EXTRACT(YEAR FROM r.datetime) AS reservation_year,
                        EXTRACT(MONTH FROM r.datetime) AS reservation_month,
                        COUNT(*) AS total_reservations,
                        ROUND(AVG(r.party_size), 1) AS avg_party_size,
                        SUM(r.party_size) AS total_guests,
                        COUNT(CASE WHEN st.description = 'Completed' THEN 1 END) AS completed_count,
                        COUNT(CASE WHEN st.description = 'Cancelled' THEN 1 END) AS cancelled_count,
                        COUNT(CASE WHEN st.description = 'No-Show' THEN 1 END) AS noshow_count
                 FROM RESERVATION r
                 JOIN STATUS_TYPE st ON r.status_ID = st.status_ID
                 GROUP BY EXTRACT(YEAR FROM r.datetime), EXTRACT(MONTH FROM r.datetime)
                 ORDER BY reservation_year DESC, reservation_month DESC''',

        's2': '''SELECT c.Customer_ID,
                        c.first_name || ' ' || c.last_name AS full_name,
                        c.email,
                        COUNT(DISTINCT r.reservation_ID) AS total_reservations,
                        COALESCE(ROUND(AVG(f.rating), 2), 0) AS avg_rating,
                        l.points AS loyalty_points,
                        lt.level AS loyalty_tier
                 FROM CUSTOMER c
                 JOIN RESERVATION r ON c.Customer_ID = r.Customer_ID
                 LEFT JOIN FEEDBACK f ON r.reservation_ID = f.reservation_ID
                 JOIN LOYALTY l ON c.Customer_ID = l.Customer_ID
                 JOIN LOYALTY_TIER lt ON l.tier_id = lt.tier_id
                 WHERE c.is_active = 1
                 GROUP BY c.Customer_ID, c.first_name, c.last_name, c.email, l.points, lt.level
                 ORDER BY total_reservations DESC, avg_rating DESC
                 LIMIT 10''',

        's5': '''SELECT CASE EXTRACT(DOW FROM r.datetime)
                            WHEN 0 THEN 'Sunday'
                            WHEN 1 THEN 'Monday'
                            WHEN 2 THEN 'Tuesday'
                            WHEN 3 THEN 'Wednesday'
                            WHEN 4 THEN 'Thursday'
                            WHEN 5 THEN 'Friday'
                            WHEN 6 THEN 'Saturday'
                        END AS day_of_week,
                        COUNT(f.feedback_ID) AS total_reviews,
                        ROUND(AVG(f.rating), 2) AS avg_rating,
                        MIN(f.rating) AS lowest_rating,
                        MAX(f.rating) AS highest_rating,
                        COUNT(CASE WHEN f.rating >= 4 THEN 1 END) AS positive_reviews,
                        COUNT(CASE WHEN f.rating <= 2 THEN 1 END) AS negative_reviews
                 FROM FEEDBACK f
                 JOIN RESERVATION r ON f.reservation_ID = r.reservation_ID
                 JOIN CUSTOMER c ON r.Customer_ID = c.Customer_ID
                 GROUP BY EXTRACT(DOW FROM r.datetime)
                 ORDER BY avg_rating DESC''',

        's8': '''SELECT EXTRACT(YEAR FROM r.datetime) AS res_year,
                        EXTRACT(MONTH FROM r.datetime) AS res_month,
                        COUNT(r.reservation_ID) AS total_reservations,
                        SUM(r.party_size) AS total_guests,
                        ROUND(AVG(r.party_size), 1) AS avg_party_size,
                        RANK() OVER (PARTITION BY EXTRACT(YEAR FROM r.datetime)
                                     ORDER BY SUM(r.party_size) DESC) AS month_rank_by_guests
                 FROM RESERVATION r
                 JOIN STATUS_TYPE st ON r.status_ID = st.status_ID
                 WHERE st.description IN ('Confirmed', 'Completed')
                 GROUP BY EXTRACT(YEAR FROM r.datetime), EXTRACT(MONTH FROM r.datetime)
                 ORDER BY res_year DESC, month_rank_by_guests ASC'''
    }
    sql = queries.get(query_id)
    if not sql:
        return jsonify(success=False, error='Unknown query')
    try:
        rows, columns = query_db(sql)
        rows = [serialize_row(r) for r in rows]
        return jsonify(success=True, data=rows, columns=columns)
    except Exception as e:
        return jsonify(success=False, error=str(e))


# =========================================================================
#  ROUTINES  (stored procedures / functions)
# =========================================================================

@app.route('/api/routine/run', methods=['POST'])
def api_routine_run():
    routine_id = request.json.get('routine_id')

    if routine_id == 'avg_feedback':
        cid = request.json.get('customer_id', 1)
        try:
            rows, cols = query_db('SELECT fn_calculate_avg_feedback_score(%s) as result', (cid,))
            result = float(rows[0]['result']) if rows and rows[0]['result'] is not None else 0
            return jsonify(success=True, message=f'Average feedback score for Customer {cid}: {result}')
        except Exception as e:
            return jsonify(success=False, error=str(e))

    elif routine_id == 'loyalty_rewards':
        try:
            before, _ = query_db('SELECT COUNT(*) as c FROM loyalty_transaction')
            before_count = before[0]['c']
            conn = get_db()
            try:
                cur = conn.cursor()
                cur.execute('CALL pr_process_loyalty_rewards()')
            finally:
                conn.close()
            after, _ = query_db('SELECT COUNT(*) as c FROM loyalty_transaction')
            after_count = after[0]['c']
            new_txns = after_count - before_count
            return jsonify(success=True, message=f'Loyalty rewards processed. {new_txns} new transactions created.')
        except Exception as e:
            return jsonify(success=False, error=str(e))

    elif routine_id == 'stale_waitlist':
        try:
            before, _ = query_db(
                "SELECT COUNT(*) as c FROM waitlist w JOIN status_type s ON w.status_id=s.status_id WHERE s.description='Waiting'"
            )
            before_count = before[0]['c']
            conn = get_db()
            try:
                cur = conn.cursor()
                cur.execute('CALL pr_resolve_stale_waitlist()')
            finally:
                conn.close()
            after, _ = query_db(
                "SELECT COUNT(*) as c FROM waitlist w JOIN status_type s ON w.status_id=s.status_id WHERE s.description='Waiting'"
            )
            after_count = after[0]['c']
            resolved = before_count - after_count
            return jsonify(success=True,
                           message=f'Stale waitlist resolved. {resolved} entries expired. Before: {before_count}, After: {after_count}.')
        except Exception as e:
            return jsonify(success=False, error=str(e))

    elif routine_id == 'remote_orders':
        cid = request.json.get('customer_id', 1)
        try:
            cust, _ = query_db('SELECT COUNT(*) as c FROM customer WHERE customer_id=%s', (cid,))
            if cust[0]['c'] == 0:
                return jsonify(success=False, error=f'Customer ID {cid} does not exist.')
            rows, cols = query_db('''
                SELECT o.order_id, o.order_time, o.order_status, b.final_amount
                FROM remote_orders."ORDER" o
                JOIN remote_orders.bill b ON o.order_id = b.order_id
                WHERE o.customer_id = %s
                ORDER BY o.order_time DESC
            ''', (cid,))
            rows = [serialize_row(r) for r in rows]
            return jsonify(success=True, data=rows, columns=cols)
        except Exception as e:
            return jsonify(success=False, error=str(e))

    else:
        return jsonify(success=False, error='Unknown routine')


# =========================================================================
#  ENTRY POINT
# =========================================================================

if __name__ == '__main__':
    app.run(host='0.0.0.0', port=5000, debug=True)
