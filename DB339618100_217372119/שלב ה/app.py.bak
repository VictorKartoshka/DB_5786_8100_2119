import os
from functools import wraps
from flask import Flask, render_template, request, jsonify, redirect, url_for, session
from db import get_db, query_db, execute_db
from datetime import date, datetime
from decimal import Decimal
import json

app = Flask(__name__)
app.secret_key = os.environ.get('SECRET_KEY', 'victors_super_secret_key_123')
ADMIN_USER = os.environ.get('ADMIN_USER', 'admin')
ADMIN_PASS = os.environ.get('ADMIN_PASS', 'admin')

def login_required(f):
    @wraps(f)
    def decorated_function(*args, **kwargs):
        if not session.get('logged_in'):
            return redirect(url_for('login', next=request.url))
        return f(*args, **kwargs)
    return decorated_function


# ---------------------------------------------------------------------------
# Helper: serialize a dict row so it is JSON-safe
# ---------------------------------------------------------------------------
def serialize_row(row):
    """Convert date/datetime/Decimal values in a dict to JSON-serializable types."""
    if row is None:
        return row
    out = {}
    for k, v in row.items():
        if isinstance(v, datetime):
            out[k] = v.isoformat()
        elif isinstance(v, date):
            out[k] = v.isoformat()
        elif isinstance(v, Decimal):
            out[k] = float(v)
        else:
            out[k] = v
    return out


# =========================================================================
#  PAGE ROUTES
# =========================================================================

@app.route('/', methods=['GET', 'POST'])
def login():
    if request.method == 'POST':
        if request.form.get('username') == ADMIN_USER and request.form.get('password') == ADMIN_PASS:
            session['logged_in'] = True
            return redirect(url_for('dashboard'))
        else:
            return render_template('login.html', error="Invalid Credentials")
    return render_template('login.html')

@app.route('/logout')
def logout():
    session.pop('logged_in', None)
    return redirect(url_for('login'))


@app.route('/dashboard')
@login_required
def dashboard():
    stats = {}
    stats['customer_count'] = query_db('SELECT COUNT(*) as c FROM customer WHERE is_active=1')[0][0]['c']
    stats['reservation_count'] = query_db('SELECT COUNT(*) as c FROM reservation')[0][0]['c']
    stats['waitlist_count'] = query_db(
        "SELECT COUNT(*) as c FROM waitlist w JOIN status_type s ON w.status_id=s.status_id WHERE s.description='Waiting'"
    )[0][0]['c']
    avg = query_db('SELECT ROUND(AVG(rating),2) as a FROM feedback')[0][0]['a']
    stats['avg_feedback'] = float(avg) if avg else 0
    return render_template('dashboard.html', stats=stats, active_page='dashboard')


@app.route('/customers')
@login_required
def customers():
    rows, cols = query_db('SELECT * FROM customer ORDER BY customer_id')
    return render_template('customers.html', customers=rows, active_page='customers')


@app.route('/reservations')
@login_required
def reservations():
    rows, cols = query_db('''
        SELECT r.reservation_id, c.first_name || ' ' || c.last_name as customer_name,
               r.datetime, r.party_size, r.special_requests, s.description as status_name,
               r.customer_id, r.status_id
        FROM reservation r
        JOIN customer c ON r.customer_id = c.customer_id
        JOIN status_type s ON r.status_id = s.status_id
        ORDER BY r.datetime DESC
    ''')
    cust_rows, _ = query_db('SELECT customer_id, first_name, last_name FROM customer WHERE is_active=1 ORDER BY customer_id')
    stat_rows, _ = query_db('SELECT status_id, description FROM status_type ORDER BY status_id')
    return render_template('reservations.html', reservations=rows, customers=cust_rows, statuses=stat_rows, active_page='reservations')


@app.route('/waitlist')
@login_required
def waitlist():
    rows, cols = query_db('''
        SELECT w.waitlist_id, c.first_name || ' ' || c.last_name as customer_name,
               w.party_size, w.request_time, w.est_wait_time, s.description as status_name,
               w.customer_id, w.status_id
        FROM waitlist w
        JOIN customer c ON w.customer_id = c.customer_id
        JOIN status_type s ON w.status_id = s.status_id
        ORDER BY w.request_time DESC
    ''')
    cust_rows, _ = query_db('SELECT customer_id, first_name, last_name FROM customer WHERE is_active=1 ORDER BY customer_id')
    stat_rows, _ = query_db('SELECT status_id, description FROM status_type ORDER BY status_id')
    return render_template('waitlist.html', entries=rows, customers=cust_rows, statuses=stat_rows, active_page='waitlist')


@app.route('/feedback')
@login_required
def feedback():
    rows, cols = query_db('''
        SELECT f.feedback_id, c.first_name || ' ' || c.last_name as customer_name,
               r.datetime as reservation_date, f.rating, f.comment, f.feedback_date,
               f.reservation_id
        FROM feedback f
        JOIN reservation r ON f.reservation_id = r.reservation_id
        JOIN customer c ON r.customer_id = c.customer_id
        ORDER BY f.feedback_date DESC
    ''')
    res_rows, _ = query_db('''
        SELECT r.reservation_id, c.first_name || ' ' || c.last_name as customer_name, r.datetime
        FROM reservation r
        JOIN customer c ON r.customer_id = c.customer_id
        ORDER BY r.datetime DESC
    ''')
    return render_template('feedback.html', feedbacks=rows, reservations=res_rows, active_page='feedback')


@app.route('/loyalty')
@login_required
def loyalty():
    loyalties, _ = query_db('''
        SELECT l.loyalty_id, c.first_name || ' ' || c.last_name as customer_name,
               l.points, l.last_updated, lt.level as tier_name,
               l.customer_id, l.tier_id
        FROM loyalty l
        JOIN customer c ON l.customer_id = c.customer_id
        JOIN loyalty_tier lt ON l.tier_id = lt.tier_id
        ORDER BY l.loyalty_id
    ''')
    tiers, _ = query_db('SELECT * FROM loyalty_tier ORDER BY tier_id')
    transactions, _ = query_db('''
        SELECT lt.transaction_id, c.first_name || ' ' || c.last_name as customer_name,
               lt.points_change, lt.created_at, r.description as reason_name,
               lt.loyalty_id, lt.reason_id
        FROM loyalty_transaction lt
        JOIN loyalty l ON lt.loyalty_id = l.loyalty_id
        JOIN customer c ON l.customer_id = c.customer_id
        JOIN reason r ON lt.reason_id = r.reason_id
        ORDER BY lt.created_at DESC
    ''')
    reasons, _ = query_db('SELECT * FROM reason ORDER BY reason_id')
    cust_rows, _ = query_db('SELECT customer_id, first_name, last_name FROM customer WHERE is_active=1 ORDER BY customer_id')
    tier_rows, _ = query_db('SELECT tier_id, level FROM loyalty_tier ORDER BY tier_id')
    return render_template(
        'loyalty.html',
        loyalties=loyalties, tiers=tiers, transactions=transactions, reasons=reasons,
        customers=cust_rows, tier_list=tier_rows, active_page='loyalty'
    )


@app.route('/orders')
@login_required
def orders():
    # FDW user has limited column access — only query permitted columns
    # and wrap each in try/except so page loads even if some tables are inaccessible
    try:
        order_rows, _ = query_db('''
            SELECT o.order_id, COALESCE(c.first_name || ' ' || c.last_name, 'Unknown') as customer_name,
                   o.table_id, o.order_time, o.order_status, o.customer_id
            FROM remote_orders."ORDER" o
            LEFT JOIN customer c ON o.customer_id = c.customer_id
            ORDER BY o.order_time DESC LIMIT 200
        ''')
    except Exception:
        order_rows = []

    try:
        bill_rows, _ = query_db('''
            SELECT b.bill_id, b.order_id, b.final_amount, b.bill_time
            FROM remote_orders.bill b
            ORDER BY b.bill_time DESC LIMIT 200
        ''')
    except Exception:
        bill_rows = []

    try:
        item_rows, _ = query_db('SELECT * FROM remote_orders.order_item ORDER BY order_item_id DESC LIMIT 200')
    except Exception:
        item_rows = []

    try:
        discount_rows, _ = query_db('SELECT * FROM remote_orders.discount ORDER BY discount_id')
    except Exception:
        discount_rows = []

    try:
        bd_rows, _ = query_db('''
            SELECT bd.bill_discount_id, bd.bill_id, bd.discount_id, d.discount_name
            FROM remote_orders.bill_discount bd
            JOIN remote_orders.discount d ON bd.discount_id = d.discount_id
            ORDER BY bd.bill_discount_id DESC LIMIT 200
        ''')
    except Exception:
        bd_rows = []

    try:
        payment_rows, _ = query_db('SELECT * FROM remote_orders.payment ORDER BY payment_time DESC LIMIT 200')
    except Exception:
        payment_rows = []

    return render_template(
        'orders.html',
        orders=order_rows, bills=bill_rows, order_items=item_rows,
        discounts=discount_rows, bill_discounts=bd_rows, payments=payment_rows,
        active_page='orders'
    )


