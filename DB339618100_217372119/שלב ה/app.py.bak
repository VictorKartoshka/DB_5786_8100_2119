# =========================================================================
#  CRUD API  –  CUSTOMER
# =========================================================================

@app.route('/api/customer/create', methods=['POST'])
def api_customer_create():
    data = request.json
    conn = get_db()
    try:
        cur = conn.cursor()
        cur.execute('SELECT COALESCE(MAX(customer_id),0)+1 FROM customer')
        new_id = cur.fetchone()['coalesce']
        cur.execute(
            'INSERT INTO customer (customer_id, first_name, last_name, phone, email, created_at, is_active) '
            'VALUES (%s,%s,%s,%s,%s,CURRENT_DATE,1)',
            (new_id, data['first_name'], data['last_name'], data['phone'], data['email'])
        )
        return jsonify(success=True)
    except Exception as e:
        return jsonify(success=False, error=str(e))
    finally:
        conn.close()


@app.route('/api/customer/fetch', methods=['POST'])
def api_customer_fetch():
    data = request.json
    conn = get_db()
    try:
        cur = conn.cursor()
        cur.execute('SELECT * FROM customer WHERE customer_id=%s', (data['id'],))
        row = cur.fetchone()
        return jsonify(success=True, data=serialize_row(row))
    except Exception as e:
        return jsonify(success=False, error=str(e))
    finally:
        conn.close()


@app.route('/api/customer/update', methods=['POST'])
def api_customer_update():
    data = request.json
    conn = get_db()
    try:
        cur = conn.cursor()
        cur.execute(
            'UPDATE customer SET first_name=%s, last_name=%s, phone=%s, email=%s WHERE customer_id=%s',
            (data['first_name'], data['last_name'], data['phone'], data['email'], data['customer_id'])
        )
        return jsonify(success=True)
    except Exception as e:
        return jsonify(success=False, error=str(e))
